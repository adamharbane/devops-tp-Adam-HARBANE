# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:5173

# =============================================================================
# PostgreSQL (service Docker : db)
# =============================================================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=reservation_app
POSTGRES_PASSWORD=reservation_secret
POSTGRES_DB=room_reservations

# URL de connexion (utile pour outils externes ou migrations)
DATABASE_URL=postgresql://reservation_app:reservation_secret@db:5432/room_reservations

# =============================================================================
# Execution locale sans Docker
# =============================================================================
# POSTGRES_HOST=localhost
# DATABASE_URL=postgresql://reservation_app:reservation_secret@localhost:5432/room_reservations
